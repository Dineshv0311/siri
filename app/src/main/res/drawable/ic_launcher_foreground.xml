<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Soft Glow -->
    <path
        android:pathData="M54,54m-38,0a38,38 0 1,0 76,0a38,38 0 1,0 -76,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="38"
                android:type="radial">
                <item android:color="#4000E5FF" android:offset="0.0" />
                <item android:color="#257C4DFF" android:offset="0.6" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Core Orb -->
    <path
        android:pathData="M54,54m-26,0a26,26 0 1,0 52,0a26,26 0 1,0 -52,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="30"
                android:endX="76"
                android:endY="78"
                android:type="linear">
                <item android:color="#FF00E5FF" android:offset="0.0" />
                <item android:color="#FF7C4DFF" android:offset="0.5" />
                <item android:color="#FFFF4081" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Highlight Orb -->
    <path
        android:pathData="M54,54m-16,0a16,16 0 1,0 32,0a16,16 0 1,0 -32,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="48"
                android:centerY="46"
                android:gradientRadius="16"
                android:type="radial">
                <item android:color="#EEFFFFFF" android:offset="0.0" />
                <item android:color="#8080D8FF" android:offset="0.5" />
                <item android:color="#00651FFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Neon Rim Wave 1 -->
    <path
        android:pathData="M24,54 C24,40 38,26 54,26 C70,26 84,40 84,54"
        android:strokeWidth="2.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="24"
                android:startY="54"
                android:endX="84"
                android:endY="26"
                android:type="linear">
                <item android:color="#FF00E5FF" android:offset="0.0" />
                <item android:color="#FFFF4081" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Neon Rim Wave 2 -->
    <path
        android:pathData="M84,54 C84,68 70,82 54,82 C38,82 24,68 24,54"
        android:strokeWidth="2.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="84"
                android:startY="54"
                android:endX="24"
                android:endY="82"
                android:type="linear">
                <item android:color="#FFFF4081" android:offset="0.0" />
                <item android:color="#FF00E5FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
